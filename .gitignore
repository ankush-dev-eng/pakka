# ──────────────────────────────────────────────────────────────────────────────
# Pakka — root .gitignore
# ──────────────────────────────────────────────────────────────────────────────

# ── Secrets / environment ─────────────────────────────────────────────────────
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# ── Python ────────────────────────────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# ── Node / Next.js ────────────────────────────────────────────────────────────
node_modules/
.next/
out/
build/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Testing ───────────────────────────────────────────────────────────────────
coverage/
playwright-report/
test-results/
.playwright/

# ── Local runtime / databases ─────────────────────────────────────────────────
*.log
*.sqlite
*.sqlite3
*.db

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ── Misc ──────────────────────────────────────────────────────────────────────
*.pem
*.tsbuildinfo
next-env.d.ts
.vercel
