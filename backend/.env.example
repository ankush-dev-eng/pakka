# Pakka — backend environment example
# Copy this file to .env and fill in real values.
# Never commit a .env with real credentials.

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Set to "mock" (default, no LLM calls) or "gemini" (requires GEMINI_API_KEY)
PAKKA_LLM=mock

# Gemini API key — only required when PAKKA_LLM=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite path (relative to backend/ directory). Do not commit .db files.
DATABASE_URL=sqlite:///./pakka.db

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ── OCR ───────────────────────────────────────────────────────────────────────
# Windows: override if Tesseract is not at the default path
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
